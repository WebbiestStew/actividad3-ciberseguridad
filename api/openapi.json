{
  "openapi": "3.0.3",
  "info": { "title": "Actividad 3 API JWT", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "paths": {
    "/health": {
      "get": { "responses": { "200": { "description": "Servicio activo" } } }
    },
    "/api/admin": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Acceso concedido" },
          "401": { "description": "Token ausente o inválido" },
          "403": { "description": "Permisos insuficientes" }
        }
      }
    }
  }
}
